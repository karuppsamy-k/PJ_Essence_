# PJ Essence Environment Variables

# App Environment
VITE_APP_ENV=development
VITE_APP_NAME="PJ Essence"
VITE_APP_URL=http://localhost:3000

# Mock Mode (Set to 'true' to run fully locally with realistic mock data & storage, or 'false' for live Firebase)
VITE_USE_MOCK_DATA=true

# Firebase Client Configuration (Web App)
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=pj-essence.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=pj-essence
VITE_FIREBASE_STORAGE_BUCKET=pj-essence.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Payment Gateway (Public Key)
VITE_STRIPE_PUBLIC_KEY=pk_test_sample_key_pj_essence

# Serverless Functions / Server-Side Private Keys (Used in Vercel backend /api endpoints)
# DO NOT expose with VITE_ prefix
FIREBASE_ADMIN_PROJECT_ID=pj-essence
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk@pj-essence.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC3...\n-----END PRIVATE KEY-----"
STRIPE_SECRET_KEY=sk_test_secret_sample_key
STRIPE_WEBHOOK_SECRET=whsec_sample_secret_key
NOTIFICATION_API_KEY=sample_notification_key
